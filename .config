#
# OpenWrt Configuration for Zyxel VMG8825-T50 (EN7516 SoC)
#

#
# Target System
#
CONFIG_TARGET_en75xx=y
CONFIG_TARGET_en75xx_en751627=y
CONFIG_TARGET_en75xx_en751627_DEVICE_zyxel_vmg8825-t50=y

#
# Target Profile
#
CONFIG_TARGET_BOARD="en75xx"
CONFIG_TARGET_SUBTARGET="en751627"
CONFIG_TARGET_PROFILE="DEVICE_zyxel_vmg8825-t50"
CONFIG_TARGET_ARCH_PACKAGES="mips_1004kc"

#
# Target Architecture
#
CONFIG_mips=y
CONFIG_ARCH="mips"
CONFIG_CPU_TYPE="1004kc"
CONFIG_CPU_SUBTYPE="dsp"
CONFIG_BIG_ENDIAN=y

#
# Kernel Configuration
#
CONFIG_KERNEL_MIPS_FPU_EMULATOR=y
CONFIG_KERNEL_SECCOMP=y

#
# USB Support
#
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-ohci-pci=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_USB_SUPPORT=y
CONFIG_DRIVER_11N_SUPPORT=y
CONFIG_DRIVER_11AC_SUPPORT=y

#
# USB WiFi Chipset Drivers
#

# Realtek RTL8187
CONFIG_PACKAGE_kmod-rtl8187=y
CONFIG_PACKAGE_kmod-rtlwifi=y
CONFIG_PACKAGE_kmod-rtlwifi-usb=y

# Ralink/MediaTek RT2800
CONFIG_PACKAGE_kmod-rt2x00=y
CONFIG_PACKAGE_kmod-rt2x00-lib=y
CONFIG_PACKAGE_kmod-rt2x00-usb=y
CONFIG_PACKAGE_kmod-rt2800-lib=y
CONFIG_PACKAGE_kmod-rt2800-usb=y

# MediaTek MT76
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-usb=y
CONFIG_PACKAGE_kmod-mt76x2u=y
CONFIG_PACKAGE_kmod-mt76x0u=y
CONFIG_PACKAGE_kmod-mt7603=y

#
# Wireless Tools
#
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wpa-supplicant=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

#
# WISP/Relay Support
#
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y

#
# LuCI Web Interface
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

#
# Network Support
#
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

#
# Basic Utilities
#
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y

#
# File Systems
#
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y

#
# Build Options
#
CONFIG_DEVEL=y
CONFIG_BROKEN=y
CONFIG_DOWNLOAD_FOLDER=""
CONFIG_LOCALMIRROR=""
CONFIG_AUTOREBUILD=y
CONFIG_BUILD_SUFFIX=""
CONFIG_TARGET_ROOTFS_DIR=""
CONFIG_EXTERNAL_KERNEL_TREE=""
CONFIG_KERNEL_GIT_CLONE_URI=""
CONFIG_BUILD_LOG=y
CONFIG_SRC_TREE_OVERRIDE=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_TARGET_UBIFS_JOURNAL_SIZE=""

#
# Image Options
#
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=512
